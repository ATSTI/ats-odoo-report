<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_invoice_document_inherit" inherit_id="account.report_invoice_document">
            <xpath expr="//t[@t-call='web.external_layout']" position="replace">
                <t t-call="web.external_layout">
                    <t t-set="o" t-value="o.with_context(lang=lang)"/>
                    <t t-set="forced_vat" t-value="o.fiscal_position_id.foreign_vat"/>
                    <!--  So that it appears in the footer of the report instead of the company VAT if it's set  -->

                    <!-- ===== INÍCIO: duas vias empilhadas, mesma página ===== -->
                    <style>
                        .via_col { font-size: 9px; }
                        .via_col h2 { font-size: 13px; margin-bottom: 4px; }
                        .via_col table.table-sm td, .via_col table.table-sm th { padding: 2px 3px !important; }
                        .via_col address { font-size: 9px; margin-bottom: 2px; }
                        .via_col .row > div { margin-bottom: 2px; }
                        .via_divider { border-top: 1px dashed #999; padding-top: 8px; margin-top: 8px; }
                    </style>

                    <t t-set="vias" t-value="[('Via do Estabelecimento', False), ('Via do Cliente', True)]"/>

                    <div>
                        <t t-foreach="vias" t-as="via_item">
                            <t t-set="via_nome" t-value="via_item[0]"/>
                            <t t-set="via_e_ultima" t-value="via_item_last"/>

                            <div t-attf-class="via_col #{'' if via_item_first else 'via_divider'}">

                                <div class="text-center mb-1">
                                    <strong t-esc="via_nome"/>
                                </div>

                                <div class="mb-1">
                                    <strong>Cliente:</strong> <span t-field="o.partner_id.name"/><br/>
                                    <strong>Endereço:</strong> <span t-field="o.partner_id.contact_address"/><br/>
                                    <strong>CPF/CNPJ:</strong> <span t-field="o.partner_id.vat"/><br/>
                                    <strong>Celular:</strong> <span t-field="o.partner_id.mobile"/><br/>
                                </div>


                                <div class="mt-1">
                                    <h2>
                                        <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Pedido</span>
                                        <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Pedido</span>
                                        <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Pedido</span>
                                        <span t-if="o.move_type == 'out_refund'">Nota de Crédito</span>
                                        <span t-if="o.move_type == 'in_refund'">Nota de Crédito do Fornecedor</span>
                                        <span t-if="o.move_type == 'in_invoice'">Conta do Fornecedor</span>
                                        <span t-if="o.name != '/'" t-field="o.name"/>
                                    </h2>
                                    <div id="informations" class="row mb-1">
                                        <div class="col-auto mw-100" t-if="o.invoice_date" name="invoice_date">
                                            <t t-if="o.move_type == 'out_invoice'">
                                                <strong>Data:</strong>
                                            </t>
                                            <t t-elif="o.move_type == 'out_refund'">
                                                <strong>Data NC:</strong>
                                            </t>
                                            <t t-elif="o.move_type == 'out_receipt'">
                                                <strong>Data recibo:</strong>
                                            </t>
                                            <t t-else="">
                                                <strong>Data:</strong>
                                            </t>
                                            <span t-field="o.invoice_date"/>
                                        </div>
                                        <div class="col-auto mw-100" t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'" name="due_date">
                                            <strong>Venc.:</strong>
                                            <span t-field="o.invoice_date_due"/>
                                        </div>
                                        <div class="col-auto mw-100" t-if="o.invoice_origin" name="origin">
                                            <strong>Origem:</strong>
                                            <span t-field="o.invoice_origin"/>
                                        </div>
                                        <div class="col-auto mw-100" t-if="o.partner_id.ref" name="customer_code">
                                            <strong>Cód. Cliente:</strong>
                                            <span t-field="o.partner_id.ref"/>
                                        </div>
                                        <div class="col-auto mw-100" t-if="o.ref" name="reference">
                                            <strong>Ref.:</strong>
                                            <span t-field="o.ref"/>
                                        </div>
                                    </div>
                                    <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>
                                    <table class="table table-sm o_main_table table-borderless" name="invoice_line_table" style="page-break-inside: auto;">
                                        <thead style="display: table-header-group;">
                                            <tr>
                                                <th name="th_description" class="text-start">
                                                    <span>Descrição</span>
                                                </th>
                                                <th name="th_quantity" class="text-end">
                                                    <span>Qtd.</span>
                                                </th>
                                                <th name="th_priceunit" class="text-end">
                                                    <span>Preço unit.</span>
                                                </th>
                                                <th name="th_price_unit" t-if="display_discount" class="text-end">
                                                    <span>Disc.%</span>
                                                </th>
                                                <th name="th_subtotal" class="text-end">
                                                    <span groups="account.group_show_line_subtotals_tax_excluded">Total</span>
                                                    <span groups="account.group_show_line_subtotals_tax_included">Preço total</span>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody class="invoice_tbody" style="display: table-row-group;">
                                            <t t-set="current_subtotal" t-value="0"/>
                                            <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>
                                            <t t-foreach="lines" t-as="line">
                                                <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                                <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>
                                                <tr style="page-break-inside: avoid;" t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                                                    <t t-if="line.display_type == 'product'" name="account_invoice_line_accountable">
                                                        <td name="account_invoice_line_name">
                                                            <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                                        </td>
                                                        <td class="text-end">
                                                            <span t-field="line.quantity"/>
                                                            <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                                        </td>
                                                        <td class="text-end">
                                                            <span class="text-nowrap" t-field="line.price_unit"/>
                                                        </td>
                                                        <td t-if="display_discount" class="text-end">
                                                            <span class="text-nowrap" t-field="line.discount"/>
                                                        </td>
                                                        <td class="text-end o_price_total">
                                                            <span class="text-nowrap" t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                                            <span class="text-nowrap" t-field="line.price_total" groups="account.group_show_line_subtotals_tax_included"/>
                                                        </td>
                                                    </t>
                                                    <t t-if="line.display_type == 'line_section'">
                                                        <td colspan="99">
                                                            <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                                        </td>
                                                        <t t-set="current_section" t-value="line"/>
                                                        <t t-set="current_subtotal" t-value="0"/>
                                                    </t>
                                                    <t t-if="line.display_type == 'line_note'">
                                                        <td colspan="99">
                                                            <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                                        </td>
                                                    </t>
                                                </tr>
                                                <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">
                                                    <tr style="page-break-inside: avoid;" class="is-subtotal text-end">
                                                        <td colspan="99">
                                                            <strong class="mr16">Subtotal</strong>
                                                            <span t-esc="current_subtotal" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </t>
                                        </tbody>
                                    </table>
                                    <div class="clearfix mb-1">
                                        <div id="total" class="row">
                                            <div class="col-8 ms-auto">
                                                <table class="table table-sm table-borderless" style="page-break-inside: avoid;">
                                                    <!-- Tax totals -->
                                                    <t t-set="tax_totals" t-value="o.tax_totals"/>
                                                    <t t-call="account.document_tax_totals"/>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                    <p class="mb-1">
                                        Entrega:
                                        <b>
                                            <t t-if="o.data_de_entrega">
                                                <span t-field="o.data_de_entrega" t-options='{"format": "dd/MM/yyyy"}'/>
                                            </t>
                                            <t t-else="">
                                                <span t-field="o.date_in_out" t-options='{"format": "dd/MM/yyyy"}'/>
                                            </t>
                                        </b>
                                    </p>
                                    <div t-field="o.invoice_payment_term_id.note" name="payment_term"/>
                                    <div t-if="not is_html_empty(o.narration)" name="comment">
                                        <span t-field="o.narration"/>
                                    </div>
                                    <p t-if="not is_html_empty(o.fiscal_position_id.note)" name="note">
                                        <span t-field="o.fiscal_position_id.note"/>
                                    </p>
                                </div>

                                <div class="mt-2" style="page-break-inside: avoid;">
                                    <div class="text-center">
                                        <div style="height: 30px;"></div>
                                        <div style="border-top: 1px solid #000; width: 30%; margin: 0 auto;"></div>
                                        <div class="mt-1">
                                            <strong>Assinatura do Cliente</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                    <!-- ===== FIM: duas vias lado a lado ===== -->

                </t>
            </xpath>
        </template>
    </data>
</odoo>