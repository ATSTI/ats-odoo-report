<odoo>
    <template id="report_deliveryslip_inherit_sections"
              inherit_id="stock.report_delivery_document">

        <xpath expr="//table[contains(@class, 'table')]/tbody" position="replace">
            <tbody>
                <t t-set="grouped_moves"
                   t-value="o.get_moves_grouped_by_section()"/>

                <t t-foreach="grouped_moves.items()" t-as="section_data">

                    <!-- Cabeçalho da seção com linha para preenchimento manual -->
                    <tr style="background-color:#f5f5f5;">
                        <td colspan="99" style="padding-bottom: 12px;">
                            <strong t-esc="section_data[0]"/>
                            <div style="
                                margin-top: 18px;
                                border-bottom: 1px solid #000;
                                width: 100%;
                                height: 20px;
                            "></div>
                        </td>
                    </tr>

                    <!-- Produtos da seção -->
                    <t t-foreach="section_data[1]" t-as="move">
                        <tr>
                            <td>
                                <span t-field="move.product_id"/>
                                <t t-if="move.description_picking and move.description_picking != move.product_id.display_name">
                                    <br/>
                                    <small t-field="move.description_picking"/>
                                </t>
                            </td>

                            <td class="text-center">
                                <span t-field="move.product_uom_qty"/>
                            </td>

                            <td class="text-center">
                                <span t-field="move.quantity"/>
                            </td>

                            <td class="text-center">
                                <span t-field="move.product_uom"/>
                            </td>
                        </tr>
                    </t>

                </t>
            </tbody>
        </xpath>

    </template>
</odoo>