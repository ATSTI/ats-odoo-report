<odoo>
    <template id="report_deliveryslip_inherit_sections"
              inherit_id="stock.report_delivery_document">

        <xpath expr="//table[@name='stock_move_table']/tbody" position="replace">
            <tbody>
                <t t-set="grouped_moves" t-value="o.get_moves_grouped_by_section()"/>
                <t t-foreach="grouped_moves.items()" t-as="section_data">

                    <tr style="background-color:#f5f5f5;">
                        <td colspan="99" style="padding-bottom:12px;">
                            <strong t-esc="section_data[0]"/>
                            <div style="margin-top:18px; border-bottom:1px solid #000; width:100%; height:20px;"/>
                        </td>
                    </tr>

                    <tr t-foreach="section_data[1]" t-as="move">
                        <td>
                            <span t-field="move.product_id"/>
                            <p t-if="move.description_picking
                                    and move.description_picking != move.product_id.name
                                    and move.description_picking != move.product_id.display_name">
                                <span t-field="move.description_picking"/>
                            </p>
                        </td>
                        <td>
                            <span t-field="move.product_uom_qty"/>
                            <span t-field="move.product_uom"/>
                        </td>
                        <td>
                            <span t-field="move.quantity_done"/>
                            <span t-field="move.product_uom"/>
                        </td>
                    </tr>

                </t>
            </tbody>
        </xpath>

        <!-- ===== TABELA 2: Entregue (state == done), sem pacotes, sem serial ===== -->
        <xpath expr="//t[@name='aggregated_move_lines']" position="replace">
            <t t-set="grouped_moves" t-value="o.get_moves_grouped_by_section()"/>
            <t t-foreach="grouped_moves.items()" t-as="section_data">

                <tr style="background-color:#f5f5f5;">
                    <td colspan="99" style="padding-bottom:12px;">
                        <strong t-esc="section_data[0]"/>
                        <div style="margin-top:18px; border-bottom:1px solid #000; width:100%; height:20px;"/>
                    </td>
                </tr>

                <tr t-foreach="section_data[1]" t-as="move">
                    <td>
                        <span t-field="move.product_id"/>
                        <p t-if="move.description_picking
                                and move.description_picking != move.product_id.name
                                and move.description_picking != move.product_id.display_name">
                            <span t-field="move.description_picking"/>
                        </p>
                    </td>
                    <!-- Pedido: quantidade original -->
                    <td class="text-center">
                        <span t-field="move.product_uom_qty"/>
                        <span t-field="move.product_uom"/>
                    </td>
                    <!-- Entregue: soma das move_lines filhas -->
                    <td class="text-center">
                        <span t-esc="sum(move.move_line_ids.mapped('qty_done'))"/>
                        <span t-field="move.product_uom"/>
                    </td>
                </tr>

            </t>
        </xpath>

    </template>
</odoo>