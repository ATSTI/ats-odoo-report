<odoo>

    <template id="report_deliveryslip_inherit_sections"
              inherit_id="stock.report_delivery_document">

        <xpath expr="//t[@t-call='web.external_layout']"
               position="replace">

            <t t-call="web.external_layout">

                <t t-set="o"
                   t-value="o.with_context(lang=o._get_report_lang())"/>

                <t t-set="partner"
                   t-value="o.partner_id or (o.move_lines and o.move_lines[0].partner_id) or False"/>
                
               <div class="page">

                    <style>
                        .rp-info table, .rp-info tr, .rp-info td {
                            border: none !important;
                            border-collapse: collapse !important;
                            border-spacing: 0 !important;
                            background: white !important;
                        }
                        .rp-info table { width: 100%; }
                    </style>

                    <div class="rp-info">

                        <table style="margin-bottom:10px;">
                            <tr>
                                <td>Cliente: <span t-field="o.partner_id.legal_name"/></td>
                            </tr>
                        </table>

                        <table style="margin-bottom:10px;">
                            <tr>
                                <td>End: <span t-field="o.partner_id.street"/></td>
                            </tr>
                        </table>

                        <table style="margin-bottom:10px;">
                            <tr>
                                <td style="width:35%;">Nº: <span t-field="o.partner_id.street_number"/></td>
                                <td style="width:65%;">Bairro: <span t-field="o.partner_id.district"/></td>
                            </tr>
                        </table>

                        <table style="margin-bottom:20px;">
                            <tr>
                                <td style="width:60%;">Cidade: <span t-field="o.partner_id.city"/></td>
                                <td style="width:40%;">CEP: <span t-field="o.partner_id.zip"/></td>
                            </tr>
                        </table>

                        <table style="margin-bottom:10px;">
                            <tr>
                                <td style="width:50%;">Data Prevista Medição Final: ___/___/_____</td>
                                <td style="width:50%;">Data Medição Final: ___/___/_____</td>
                            </tr>
                        </table>

                        <table style="margin-bottom:20px;">
                            <tr>
                                <td style="width:50%;">Data Prevista da Instalação: ___/___/_____</td>
                                <td style="width:50%;">Data Instalação: De ___/___/_____ A ___/___/_____</td>
                            </tr>
                        </table>

                        <table style="margin-bottom:10px;">
                            <tr>
                                <td>Cor do Kit: __________</td>
                                <td>Modelo: __________________</td>
                                <td>Fornecedor: __________</td>
                                <td>QT: ______</td>
                            </tr>
                        </table>

                        <table style="margin-bottom:15px;">
                            <tr>
                                <td>Cor do Kit: __________</td>
                                <td>Modelo: __________________</td>
                                <td>Fornecedor: __________</td>
                                <td>QT: ______</td>
                            </tr>
                        </table>

                        <table style="margin-bottom:15px;">
                            <tr>
                                <td>QT. Giro: __________</td>
                                <td>QT. Correr: __________</td>
                            </tr>
                        </table>

                        <div style="margin-bottom:12px;">
                            Corte da Guarnição:
                            45º ( ) &#160;&#160;
                            90º ( ) .
                            Tamanho:
                            3( ) &#160;
                            5( ) &#160;
                            7( ) &#160;
                            Plus ( )
                        </div>

                        <div style="margin-bottom:20px;">
                            Guarnições Interna no banheiro:
                            Até chão:( ) &#160;&#160;
                            Até soleira:( )
                        </div>

                        <table style="margin-bottom:10px;">
                            <tr>
                                <td>Cor da Ferragem: __________</td>
                                <td>Modelo: __________</td>
                                <td>Fornecedor: __________</td>
                                <td>QT: ______</td>
                            </tr>
                        </table>

                        <table style="margin-bottom:20px;">
                            <tr>
                                <td>Fechadura Eletrônica: __________</td>
                                <td>Modelo: __________</td>
                                <td>Fornecedor: __________</td>
                                <td>QT: ______</td>
                            </tr>
                        </table>

                        <table style="margin-bottom:10px;">
                            <tr>
                                <td style="width:50%;">Data compra kits: ___/___/_____</td>
                                <td style="width:50%;">Data prevista entrega: ___/___/_____</td>
                            </tr>
                        </table>

                        <table style="margin-bottom:25px;">
                            <tr>
                                <td style="width:50%;">Data compra ferragens: ___/___/_____</td>
                                <td style="width:50%;">Data prevista da entrega: ___/___/_____</td>
                            </tr>
                        </table>

                        <table style="margin-bottom:15px;">
                            <tr>
                                <td style="width:80%;"><strong>Pendências:</strong></td>
                                <td style="width:20%; text-align:right;">Data de retorno: ___/___/_____</td>
                            </tr>
                        </table>

                        <div style="border-bottom:1px solid #000; height:18px;"></div>
                        <div style="border-bottom:1px solid #000; height:18px;"></div>
                        <div style="border-bottom:1px solid #000; height:18px; margin-bottom:15px;"></div>

                        <div style="margin-bottom:5px;"><strong>OBS:</strong></div>

                        <div style="border-bottom:1px solid #000; height:18px;"></div>
                        <div style="border-bottom:1px solid #000; height:18px;"></div>
                        <div style="border-bottom:1px solid #000; height:18px;"></div>
                        <div style="border-bottom:1px solid #000; height:18px;"></div>
                        <div style="border-bottom:1px solid #000; height:18px;"></div>
                        <div style="border-bottom:1px solid #000; height:18px;"></div>

                    </div>
                </div>  
              <div class="page" style="page-break-before: always;">

                    <div class="row mt32 mb32">
                        <div t-if="o.picking_type_id.code == 'outgoing'" class="col-6">
                            <strong>Endereço de Entrega:</strong>
                            <div t-field="o.partner_id"
                                t-options='{
                                    "widget": "contact",
                                    "fields": ["address", "name", "phone"],
                                    "no_marker": True,
                                    "phone_icons": True
                                }'/>
                        </div>
                    </div>
                    <h2>
                        <span t-field="o.name"/>
                    </h2>
                    <div class="row mt32 mb32">
                        <div class="col-auto" t-if="o.origin">
                            <strong>Pedido:</strong>
                            <p t-field="o.origin"/>
                        </div>
                        <div class="col-auto" t-if="o.scheduled_date">
                            <strong>Data de Envio:</strong>
                            <p t-field="o.scheduled_date"/>
                        </div>
                    </div>
                   <t t-if="o.sale_id">
                        <t t-set="item_number" t-value="1"/>

                        <t t-foreach="o._get_lines_grouped_by_ambiente()"
                        t-as="group">
                            <div style="page-break-inside: avoid; margin-bottom: 15px;">

                                <t t-if="group['section_name'] and 'espuma expansiva' in group['section_name'].lower()">
                                    <table style="width:100%; border-collapse:collapse; font-size:10px;">
                                        <tr>
                                            <td colspan="3" style="border:1px solid #000; padding:6px; font-weight:bold; background-color:#f0f0f0; font-size:12px;">
                                                <span t-esc='group["section_name"]'/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="border:1px solid #000; text-align:center; font-weight:bold; background-color:#f0f0f0; width:60%;">ITEM</td>
                                            <td style="border:1px solid #000; text-align:center; font-weight:bold; background-color:#f0f0f0; width:20%;">QUANTIDADE</td>
                                            <td style="border:1px solid #000; text-align:center; font-weight:bold; background-color:#f0f0f0; width:20%;">VALOR</td>
                                        </tr>
                                        <tr>
                                            <td style="border:1px solid #000; padding:6px;">
                                                <span t-esc="group['names']"/>
                                            </td>
                                            <td style="border:1px solid #000; text-align:center;">
                                                <span t-esc="group['qty']"/>
                                            </td>
                                            <td style="border:1px solid #000; text-align:center;">
                                                <span t-esc="group['price']"
                                                    t-options='{"widget": "monetary", "display_currency": o.sale_id.currency_id}'/>
                                            </td>
                                        </tr>
                                    </table>
                                </t>

                                <!-- ===================== -->
                                <!-- CASO: PADRÃO (portas)  -->
                                <!-- ===================== -->
                                <t t-else="">
                                    <table style="width:100%; border-collapse:collapse; font-size:9px;">
                                        <tr>
                                            <span t-esc='group["section_name"]'/>
                                            <td style="width:10%; border:1px solid #000; text-align:center; vertical-align:middle; font-weight:bold; font-size:16px; padding:6px; background-color:#f0f0f0;">
                                                ITEM<br/><span t-esc="item_number"/>
                                            </td>
                                            <td style="width:8%; border:1px solid #000; text-align:center; vertical-align:middle; padding:4px; background-color:#f0f0f0;">
                                                <div style="font-size:8px; font-weight:normal;">QTD</div>
                                                <div style="font-size:13px; font-weight:bold;"><span t-esc="group['qty']"/></div>
                                            </td>
                                            <td colspan="7" style="border:1px solid #000; padding:6px; font-size:11px; font-weight:bold; vertical-align:middle; background-color:#FFFFFF;">
                                                <span t-esc="group['names']"/>
                                            </td>
                                        </tr>

                                        <tr>
                                            <td style="border:1px solid #000; text-align:center; font-size:8px; background-color:#f0f0f0;"><strong>LARGURA FOLHA</strong></td>
                                            <td style="border:1px solid #000; text-align:center; font-size:8px; background-color:#f0f0f0;"><strong>LARGURA VAO</strong></td>
                                            <td style="border:1px solid #000; text-align:center; font-size:8px; background-color:#f0f0f0;"><strong>ALTURA FOLHA</strong></td>
                                            <td style="border:1px solid #000; text-align:center; font-size:8px; background-color:#f0f0f0;"><strong>ESP. FOLHA</strong></td>
                                            <td style="border:1px solid #000; text-align:center; font-size:8px; background-color:#f0f0f0;"><strong>ESP. PAREDE</strong></td>
                                            <td style="border:1px solid #000; text-align:center; font-size:8px; background-color:#f0f0f0;"><strong>ESP. BATENTE</strong></td>
                                            <td style="border:1px solid #000; text-align:center; font-size:8px; background-color:#f0f0f0;"><strong>LARGURA ALIZAR</strong></td>
                                            <td style="border:1px solid #000; text-align:center; font-size:8px; background-color:#f0f0f0;"><strong>ALTURA ALIZAR</strong></td>
                                            <td style="border:1px solid #000; text-align:center; font-size:8px; width:14%; background-color:#f0f0f0;"><strong>ABERTURA</strong></td>
                                        </tr>

                                        <tr>
                                            <td style="border:1px solid #000; height:25px; background-color:#f0f0f0;"></td>
                                            <td style="border:1px solid #000; height:35px;background-color:#f0f0f0;"></td>
                                            <td style="border:1px solid #000; height:35px;background-color:#f0f0f0;"></td>
                                            <td style="border:1px solid #000; height:35px;background-color:#f0f0f0;"></td>
                                            <td style="border:1px solid #000; height:35px;background-color:#f0f0f0;"></td>
                                            <td style="border:1px solid #000; height:35px;background-color:#f0f0f0;"></td>
                                            <td style="border:1px solid #000; height:35px;background-color:#f0f0f0;"></td>
                                            <td style="border:1px solid #000; height:35px;background-color:#f0f0f0;"></td>
                                        </tr>

                                        <tr>
                                            <td style="border:1px solid #000; text-align:center; font-size:8px; background-color:#f0f0f0;"><strong>COR</strong></td>
                                            <td style="border:1px solid #000; text-align:center; font-size:8px; background-color:#f0f0f0;"><strong>ALTURA VAO</strong></td>
                                            <td style="border:1px solid #000; text-align:center; font-size:8px; background-color:#f0f0f0;"><strong>ACABAMENTO</strong></td>
                                            <td style="border:1px solid #000; text-align:center; font-size:8px; background-color:#f0f0f0;"><strong>MODELO</strong></td>
                                            <td style="border:1px solid #000; text-align:center; font-size:8px; background-color:#f0f0f0;"><strong>ENCHIMENTO</strong></td>
                                            <td style="border:1px solid #000; text-align:center; font-size:8px; background-color:#f0f0f0;"><strong>FECHADURA</strong></td>
                                            <td style="border:1px solid #000; text-align:center; font-size:8px; background-color:#f0f0f0;"><strong>DOBRADIÇA</strong></td>
                                            <td style="border:1px solid #000; text-align:center; font-size:8px; background-color:#f0f0f0;"><strong>COR FERRAGENS</strong></td>
                                        </tr>

                                        <tr>
                                            <td style="border:1px solid #000; height:35px; background-color:#f0f0f0;"></td>
                                            <td style="border:1px solid #000; height:35px;background-color:#f0f0f0;"></td>
                                            <td style="border:1px solid #000; height:35px;background-color:#f0f0f0;"></td>
                                            <td style="border:1px solid #000; height:35px; background-color:#f0f0f0;"></td>
                                            <td style="border:1px solid #000; height:35px;background-color:#f0f0f0;"></td>
                                            <td style="border:1px solid #000; height:35px;background-color:#f0f0f0;"></td>
                                            <td style="border:1px solid #000; height:35px;background-color:#f0f0f0;"></td>
                                            <td style="border:1px solid #000; height:35px;background-color:#f0f0f0;"></td>
                                        </tr>

                                    </table>

                                    <table style="width:100%; border-collapse:collapse; margin-top:-1px;">
                                        <tr>
                                            <td style="border:1px solid #000; height:30px; padding:5px; background-color:#f0f0f0;">
                                                <strong>OBSERVAÇÃO:</strong>
                                                <span style="display:inline-block; border-bottom:1px solid #000; width:85%; margin-left:4px; vertical-align:bottom;">&#160;</span>
                                            </td>
                                        </tr>
                                    </table>
                                </t>

                            </div>

                            <t t-set="item_number" t-value="item_number + 1"/>
                        </t>
                    </t>

                    <table style="
                            width:100%;
                            border:none !important;
                            border-collapse:collapse;
                            background-color:white !important;
                            margin-top:60px;
                            page-break-inside: avoid;
                        ">
                            <tr style="background:transparent !important;">
                                <td style="
                                    border:none !important;
                                    background:transparent !important;
                                ">
                                    _______________________________________<br/>
                                    Assinatura do Cliente
                                </td>

                                <td style="
                                    border:none !important;
                                    background:transparent !important;
                                ">
                                    _______________________________________<br/>
                                    Responsável pela Instalação
                                </td>
                            </tr>
                        </table>

                </div>
                    <div class="page" style="page-break-before: always;">

                        <h2 style="text-align:center; margin-bottom:20px;">
                            CHECKLIST DE ENTREGA
                        </h2>

                        <table style="
                            width:100%;
                            border:none !important;
                            border-collapse:collapse;
                            background-color:white !important;
                        ">
                            <tr style="background:transparent !important;">
                                <td style="
                                    border:none !important;
                                    background:transparent !important;
                                ">
                                    <strong>Cliente:</strong>
                                    ________________________________________________
                                </td>
                            </tr>

                            <tr>
                                <td style="
                                    border:none !important;
                                    background:transparent !important;
                                ">
                                    <strong>Endereço da Obra:</strong>
                                    ________________________________________________
                                </td>
                            </tr>

                            <tr>
                                <td style="
                                    border:none !important;
                                    background:transparent !important;
                                ">
                                    <strong>Data da Instalação:</strong>
                                    ____ / ____ / ________
                                </td>
                            </tr>

                            <tr>
                                <td style="
                                    border:none !important;
                                    background:transparent !important;
                                ">
                                    <strong>Responsável Técnico:</strong>
                                    ________________________________________________
                                </td>
                            </tr>
                        </table>

                        <h4>ITENS VERIFICADOS APÓS A INSTALAÇÃO</h4>

                        <p><strong>1. Folhas das portas</strong></p>
                        <p>☐ Sem riscos, amassados ou trincas</p>
                        <p>☐ Alinhadas e funcionando corretamente</p>
                        <p>☐ Abertura e fechamento adequados</p>

                        <p><strong>2. Guarnições / Acabamentos</strong></p>
                        <p>☐ Todas devidamente instaladas</p>
                        <p>☐ Sem folgas e bem encaixadas</p>
                        <p>☐ Acabamento limpo e uniforme</p>

                        <p><strong>3. Fechaduras e Ferragens</strong></p>
                        <p>☐ Corretamente instaladas</p>
                        <p>☐ Funcionamento testado e aprovado</p>
                        <p>☐ Chaves entregues ao cliente</p>

                        <p><strong>4. Batentes</strong></p>
                        <p>☐ Fixados corretamente</p>
                        <p>☐ Sem movimentação ou folgas</p>
                        <p>☐ Nivelamento conferido</p>

                        <p><strong>5. Limpeza Final</strong></p>
                        <p>☐ Área de trabalho limpa</p>
                        <p>☐ Resíduos removidos</p>
                        <p>☐ Ambiente liberado para uso</p>
                        <br/> <br/> <br/> <br/>
                        <p><strong>6. Conferência do Cliente</strong></p>
                        <p>☐ Cliente realizou conferência das portas</p>
                        <p>☐ Cliente testou funcionamento das portas</p>
                        <p>☐ Cliente aprovou a instalação realizada</p>

                        <br/>

                        <h4>TERMO DE RECEBIMENTO E ACEITE</h4>

                        <p style="text-align:justify;">
                            Eu, ____________________________________________,
                            declaro para os devidos fins que recebi os produtos e serviços
                            referentes à instalação das portas internas "Kit Pronto",
                            constatando que os itens foram entregues e instalados em perfeitas
                            condições de uso, funcionamento e acabamento, sem avarias aparentes,
                            conforme contratado.
                        </p>

                        <p style="text-align:justify;">
                            Declaro ainda que realizei a conferência dos serviços executados,
                            estando ciente e de acordo com a entrega definitiva da obra referente
                            à instalação das portas.
                        </p>

                        <p>
                            <strong>Observações:</strong>
                        </p>

                        <div style="height:120px; border:1px solid #000;"></div>

                        <br/><br/>

                        <table style="
                            width:100%;
                            border:none !important;
                            border-collapse:collapse;
                            background-color:white !important;
                        ">
                            <tr style="background:transparent !important;">
                                <td style="
                                    border:none !important;
                                    background:transparent !important;
                                ">
                                    <strong>Local:</strong>
                                    ______________________________
                                </td>

                                <td style="
                                    border:none !important;
                                    background:transparent !important;
                                ">
                                    <strong>Data:</strong>
                                    ____ / ____ / ________
                                </td>
                            </tr>
                        </table>

                        <br/><br/>

                        <table style="
                            width:100%;
                            border:none !important;
                            border-collapse:collapse;
                            background-color:white !important;
                        ">
                            <tr style="background:transparent !important;">
                                <td style="
                                    border:none !important;
                                    background:transparent !important;
                                ">
                                    _______________________________________<br/>
                                    Assinatura do Cliente
                                </td>

                                <td style="
                                    border:none !important;
                                    background:transparent !important;
                                ">
                                    _______________________________________<br/>
                                    Responsável pela Instalação
                                </td>
                            </tr>
                        </table>
                    </div>
            </t>
        </xpath>
    </template>
</odoo>
