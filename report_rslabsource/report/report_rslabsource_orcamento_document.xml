<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_rslabsource">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="report_rslabsource.report_rslabsource_document"
                   t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>

    <template id="report_rslabsource_document">
        <t t-call="web.basic_layout">
            <t t-set="doc" t-value="o"/>
            <t t-set="currency_symbol" t-value="'US$' if o.moeda_cotacao == 'USD' else 'R$'"/>

            <div class="page" style="font-family: Arial, sans-serif; font-size: 13px; color: #000;">

                <!-- CABEÇALHO COM DIVS -->
                <div class="row align-items-center mb-1" style="border: none !important; width: 100%;">
                    <!-- LOGO NA ESQUERDA -->
                    <div class="col-3" style="border: none !important; text-align: left !important; padding-left: 0;">
                        <t t-if="o.company_id.logo">
                            <img t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 110px; max-width: 200px;"/>
                        </t>
                    </div>

                    <!-- BLOCO DE DADOS ALINHADO TOTALMENTE À DIREITA -->
                    <div class="col-9 ml-auto" style="border: none !important; text-align: right !important; padding-right: 0; line-height: 1.5;">
                        <strong style="font-size: 16px;"><t t-esc="o.company_id.name"/></strong><br/>
                        
                        <t t-esc="o.company_id.street"/>
                        <t t-if="o.company_id.street2"> - <t t-esc="o.company_id.street2"/></t>
                        <t t-if="o.company_id.district"> - <t t-esc="o.company_id.district"/></t><br/>
                        
                        <t t-if="o.company_id.city_id"><t t-esc="o.company_id.city_id.name"/></t>
                        <t t-elif="o.company_id.city"><t t-esc="o.company_id.city"/></t>
                        <t t-if="o.company_id.state_id"> - <t t-esc="o.company_id.state_id.code"/></t>
                        <t t-if="o.company_id.zip"> | CEP: <t t-esc="o.company_id.zip"/></t>
                        <t t-if="o.company_id.phone"> | Tel: <t t-esc="o.company_id.phone"/></t><br/>
                        
                        <t t-if="o.company_id.cnpj_cpf">CNPJ: <t t-esc="o.company_id.cnpj_cpf"/></t>
                        <t t-if="o.company_id.inscr_est"> | IE: <t t-esc="o.company_id.inscr_est"/></t><br/>
                        
                        <t t-if="o.company_id.website"><t t-esc="o.company_id.website"/></t>
                    </div>
                </div>

                <hr style="border: none; border-top: 1px solid #898989; margin: 5px 0;"/>

                <div class="row mb-2" style="border: none !important;">
                    <div class="col-7" style="border: none !important;">
                        <strong style="font-size: 15px;">
                            Orçamento de Venda &amp;nbsp; <t t-esc="o.name"/>
                        </strong>
                    </div>
                    <div class="col-5 ml-auto" style="border: none !important; text-align: right !important;">
                        <strong>Data:</strong>
                        <span t-field="o.date_order" t-options='{"widget": "date"}'/>
                    </div>
                </div>

                <!-- DADOS DO CLIENTE EM DIVS -->
                <div style="border: 1px solid #000; margin-bottom: 8px; font-size: 13px;">
                    <div style="background-color: #e0e0e0; padding: 3px 6px; font-weight: bold; border-bottom: 1px solid #000;">
                        Dados do Cliente
                    </div>
                    <div style="padding: 4px 6px;">
                        <strong>
                            <t t-if="o.partner_id.ref"><t t-esc="o.partner_id.ref"/> - </t>
                            <t t-esc="o.partner_id.name"/>
                        </strong>
                    </div>
                    <div style="padding: 2px 6px;">
                        <strong>Endereço:</strong> <t t-esc="o.partner_id.street or ''"/>
                        <t t-if="o.partner_id.street2"> - <t t-esc="o.partner_id.street2"/></t>
                    </div>
                    <div class="row no-gutters" style="padding: 2px 6px;">
                        <div class="col-3"><strong>Bairro:</strong> <t t-esc="o.partner_id.district or ''"/></div>
                        <div class="col-3"><strong>CEP:</strong> <t t-esc="o.partner_id.zip or ''"/></div>
                        <div class="col-3"><strong>Cidade:</strong> <t t-esc="o.partner_id.city_id.name or o.partner_id.city or ''"/></div>
                        <div class="col-3"><strong>UF:</strong> <t t-esc="o.partner_id.state_id.code or ''"/></div>
                    </div>
                    <div class="row no-gutters" style="padding: 2px 6px;">
                        <div class="col-6"><strong>CNPJ/CPF:</strong> <t t-esc="o.partner_id.vat or ''"/></div>
                        <div class="col-6"><strong>I.E:</strong> <t t-esc="o.partner_id.inscr_est or ''"/></div>
                    </div>
                    <div class="row no-gutters" style="padding: 2px 6px;">
                        <div class="col-6">
                            <strong>Telefone:</strong> <t t-esc="o.partner_id.phone or ''"/>
                            <t t-if="o.partner_id.mobile"> / <t t-esc="o.partner_id.mobile"/></t>
                        </div>
                        <div class="col-6"><strong>E-mail:</strong> <t t-esc="o.partner_id.email or ''"/></div>
                    </div>
                    <t t-if="o.partner_id.child_ids">
                        <div style="padding: 2px 6px;">
                            <strong>Contato(s):</strong>
                            <t t-foreach="o.partner_id.child_ids[:2]" t-as="child">
                                <t t-esc="child.name"/>
                                <t t-if="child.phone"> (<t t-esc="child.phone"/>)</t>
                                <t t-if="child.email"> (<t t-esc="child.email"/>)</t>
                                <t t-if="not child_last"> · </t>
                            </t>
                        </div>
                    </t>
                </div>

                <!-- ITENS -->
                <table width="100%" style="border-collapse: collapse; border: 1px solid #ccc; margin-bottom: 6px; font-size: 11px;">
                    <thead>
                        <tr style="background-color: #4472C4; color: #fff; text-align: center;">
                            <th style="border: 1px solid #ccc; padding: 4px 5px; width: 12%;">Part Number</th>
                            <th style="border: 1px solid #ccc; padding: 4px 5px; width: 40%;">Descrição</th>
                            <th style="border: 1px solid #ccc; padding: 4px 5px; width: 5%;">NCM</th>
                            <th style="border: 1px solid #ccc; padding: 4px 5px; width: 8%;">Entrega</th>
                            <th style="border: 1px solid #ccc; padding: 4px 5px; width: 6%;">Qtde</th>
                            <th style="border: 1px solid #ccc; padding: 4px 5px; width: 9%;">Preço unitário</th>
                            <th style="border: 1px solid #ccc; padding: 4px 5px; width: 5%;">% ICMS</th>
                            <th style="border: 1px solid #ccc; padding: 4px 5px; width: 6%;">Red. ICMS</th>
                            <th style="border: 1px solid #ccc; padding: 4px 5px; width: 5%;">IPI</th>
                            <th style="border: 1px solid #ccc; padding: 4px 5px; width: 6%;">V. Desc.</th>
                            <th style="border: 1px solid #ccc; padding: 4px 5px; width: 9%;">Preço Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="o.order_line" t-as="line">
                            <tr style="vertical-align: top;">
                                <td style="border: 1px solid #ccc; padding: 6px 5px; text-align: center;">
                                    <t t-esc="(line.product_id.default_code or '')[:14]"/>
                                </td>
                                <!-- CÉLULA DA DESCRIÇÃO COM MAIOR ESPAÇAMENTO ENTRE LINHAS -->
                                <td style="border: 1px solid #ccc; padding: 6px 8px; line-height: 1.35;">
                                    <div style="margin-bottom: 4px;">
                                        <t t-esc="line.product_id.name.split('] ', 1)[1] if line.product_id.name and '] ' in line.product_id.name else line.product_id.name"/>
                                    </div>
                                    <t t-if="line.product_id.description_sale">
                                        <div style="font-size: 11px; color: #555; margin-top: 3px; line-height: 1.4;">
                                            <t t-esc="line.product_id.description_sale"/>
                                        </div>
                                    </t>
                                </td>
                                <td style="border: 1px solid #ccc; padding: 6px 5px; text-align: center;">
                                    <t t-if="line.product_id.ncm_id">
                                        <t t-esc="line.product_id.ncm_id.code"/>
                                    </t>
                                </td>
                                <td style="border: 1px solid #ccc; padding: 6px 5px; text-align: center;">
                                    <t t-if="line.customer_lead and o.date_order">
                                        <t t-set="data_prevista" t-value="o.date_order + datetime.timedelta(days=int(line.customer_lead))"/>
                                        <span t-esc="data_prevista.strftime('%d/%m/%y')"/>
                                    </t>
                                    <t t-else="">-</t>
                                </td>
                                <td style="border: 1px solid #ccc; padding: 6px 5px; text-align: center;">
                                    <t t-esc="'%.2f' % line.product_uom_qty"/>
                                </td>
                                <td style="border: 1px solid #ccc; padding: 6px 5px; text-align: center;">
                                    <span style="white-space: nowrap;">
                                        <t t-esc="currency_symbol"/>
                                        <t t-esc="'{:,.2f}'.format(line.price_unit).replace(',', 'X').replace('.', ',').replace('X', '.')"/>
                                    </span>
                                </td>
                                <td style="border: 1px solid #ccc; padding: 6px 5px; text-align: center;">
                                    <t t-set="icms_tax" t-value="line.tax_id.filtered(lambda t: 'icms' in t.name.lower())"/>
                                    <t t-if="icms_tax">
                                        <t t-esc="'%.2f' % icms_tax[0].amount"/>
                                    </t>
                                    <t t-else="">0,00</t>
                                </td>
                                <td style="border: 1px solid #ccc; padding: 6px 5px; text-align: center;">0,00</td>
                                <td style="border: 1px solid #ccc; padding: 6px 5px; text-align: center;">
                                    <t t-set="ipi_tax" t-value="line.tax_id.filtered(lambda t: 'ipi' in t.name.lower())"/>
                                    <t t-if="ipi_tax">
                                        <t t-esc="'%.2f' % ipi_tax[0].amount"/>
                                    </t>
                                    <t t-else="">0,00</t>
                                </td>
                                <td style="border: 1px solid #ccc; padding: 6px 5px; text-align: center;">
                                    <t t-if="line.discount">
                                        <span style="white-space: nowrap;">
                                            <t t-esc="'{:,.2f}'.format(line.price_unit * line.product_uom_qty * line.discount / 100).replace(',', 'X').replace('.', ',').replace('X', '.')"/>
                                        </span>
                                    </t>
                                    <t t-else="">
                                        <span style="white-space: nowrap;">0,00</span>
                                    </t>
                                </td>
                                <td style="border: 1px solid #ccc; padding: 6px 5px; text-align: center; font-weight: bold;">
                                    <span style="white-space: nowrap;">
                                        <t t-esc="currency_symbol"/>
                                        <t t-esc="'{:,.2f}'.format(line.price_subtotal).replace(',', 'X').replace('.', ',').replace('X', '.')"/>
                                    </span>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="4" style="border: 1px solid #ccc; padding: 4px 5px;"/>
                            <td style="border: 1px solid #ccc; padding: 4px 5px; text-align: center; font-weight: bold;">
                                <t t-esc="'%.2f' % sum(o.order_line.mapped('product_uom_qty'))"/>
                            </td>
                            <td colspan="6" style="border: 1px solid #ccc; padding: 4px 5px;"/>
                        </tr>
                    </tfoot>
                </table>

                <!-- TOTALIZADORES -->
                <div class="row mb-2" style="font-size: 12px; page-break-inside: avoid; border: none !important;">
                    <div class="col-7" style="padding: 4px 0; border: none !important;">
                        <strong>Obs:</strong>
                        <t t-if="o.note"><span t-field="o.note"/></t>
                    </div>
                    <div class="col-5" style="border: none !important;">
                        <table width="100%" style="border-collapse: collapse;">
                            <tr>
                                <td style="padding: 2px 6px; border: 1px solid #ccc;">Total dos Produtos</td>
                                <td style="padding: 2px 6px; border: 1px solid #ccc; text-align: left;">
                                    <span style="white-space: nowrap;">
                                        <t t-esc="currency_symbol"/>
                                        <t t-esc="'{:,.2f}'.format(o.amount_untaxed).replace(',','X').replace('.', ',').replace('X','.')"/>
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 2px 6px; border: 1px solid #ccc;">Valor do IPI</td>
                                <td style="padding: 2px 6px; border: 1px solid #ccc; text-align: left;">
                                    <span style="white-space: nowrap;">
                                        <t t-esc="currency_symbol"/>
                                        <t t-esc="'{:,.2f}'.format(o.amount_tax).replace(',','X').replace('.', ',').replace('X','.')"/>
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 2px 6px; border: 1px solid #ccc;">Frete/Seguro</td>
                                <td style="padding: 2px 6px; border: 1px solid #ccc; text-align: left;">
                                    <span style="white-space: nowrap;"><t t-esc="currency_symbol"/> 0,00</span>
                                </td>
                            </tr>
                            <tr style="font-weight: bold;">
                                <td style="padding: 3px 6px; border: 2px solid #000; background-color: #f0f0f0;">
                                    Total do Orçamento
                                </td>
                                <td style="padding: 3px 6px; border: 2px solid #000; background-color: #f0f0f0; text-align: left;">
                                    <span style="white-space: nowrap;">
                                        <t t-esc="currency_symbol"/>
                                        <t t-esc="'{:,.2f}'.format(o.amount_total).replace(',','X').replace('.', ',').replace('X','.')"/>
                                    </span>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>

                    <!-- OBSERVAÇÕES E DADOS BANCÁRIOS EM DIVS -->
                    <div style="page-break-inside: avoid; font-family: Arial, sans-serif; font-size: 13px; color: #000; margin-top: 10px;">
                        
                        <!-- CABEÇALHO COM DIVS -->
                    <div class="row align-items-center mb-1" style="border: none !important; width: 100%;">
                        <!-- LOGO NA ESQUERDA -->
                        <div class="col-3" style="border: none !important; text-align: left !important; padding-left: 0;">
                            <t t-if="o.company_id.logo">
                                <img t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 110px; max-width: 200px;"/>
                            </t>
                        </div>

                        <!-- BLOCO DE DADOS ALINHADO TOTALMENTE À DIREITA -->
                        <div class="col-9 ml-auto" style="border: none !important; text-align: right !important; padding-right: 0; line-height: 1.5;">
                            <strong style="font-size: 16px;"><t t-esc="o.company_id.name"/></strong><br/>
                            
                            <t t-esc="o.company_id.street"/>
                            <t t-if="o.company_id.street2"> - <t t-esc="o.company_id.street2"/></t>
                            <t t-if="o.company_id.district"> - <t t-esc="o.company_id.district"/></t><br/>
                            
                            <t t-if="o.company_id.city_id"><t t-esc="o.company_id.city_id.name"/></t>
                            <t t-elif="o.company_id.city"><t t-esc="o.company_id.city"/></t>
                            <t t-if="o.company_id.state_id"> - <t t-esc="o.company_id.state_id.code"/></t>
                            <t t-if="o.company_id.zip"> | CEP: <t t-esc="o.company_id.zip"/></t>
                            <t t-if="o.company_id.phone"> | Tel: <t t-esc="o.company_id.phone"/></t><br/>
                            
                            <t t-if="o.company_id.cnpj_cpf">CNPJ: <t t-esc="o.company_id.cnpj_cpf"/></t>
                            <t t-if="o.company_id.inscr_est"> | IE: <t t-esc="o.company_id.inscr_est"/></t><br/>
                            
                            <t t-if="o.company_id.website"><t t-esc="o.company_id.website"/></t>
                        </div>
                    </div>

                    <div style="border: 1px solid #000; font-size: 12px;">
                        <div style="padding: 6px; border-bottom: 1px solid #000;">
                            <strong>OBSERVAÇÕES GERAIS:</strong><br/><br/>
                            CONDIÇÃO DE PAGAMENTO: <t t-esc="o.payment_term_id.name if o.payment_term_id else 'A COMBINAR'"/><br/>
                            VALIDADE DA PROPOSTA: 
                            <t t-if="o.validity_date"><t t-esc="o.validity_date.strftime('%d/%m/%Y')"/></t>
                            <t t-else="">15 DIAS</t><br/>
                            FRETE/SEGURO: CIF (POR CONTA DO EMITENTE)<br/><br/>
                            OS PRAZOS DE ENTREGA ESTÃO NO LIMITE MÁXIMO. TEMOS COMO ROTINA ANTECIPAR A ENTREGA DOS PRAZOS PREVIAMENTE ESTIPULADOS.<br/>
                            ANTES DA CONFIRMAÇÃO DA COMPRA, POR FAVOR, VERIFIQUE SE OS PRODUTOS ORÇADOS ESTÃO DE ACORDO COM AS SUAS EXIGÊNCIAS.
                        </div>
                        <div style="padding: 6px;">
                            <strong>DADOS BANCÁRIOS:</strong><br/><br/>
                            <strong>RS LABSOURCE SUPRIMENTOS ANALÍTICOS LTDA</strong><br/>
                            CNPJ: 28.550.919/0001-78<br/>
                            BANCO: SANTANDER (033)<br/>
                            AGÊNCIA: 0237<br/>
                            CONTA CORRENTE: 13002427-7<br/><br/>
                            CHAVE PIX: 28.550.919/0001-78
                        </div>
                    </div>

                    <div style="margin-top: 40px; text-align: right; font-size: 12px;">
                        <strong>ATENCIOSAMENTE,</strong><br/><br/>
                        <t t-esc="o.user_id.name"/><br/><br/>
                        <t t-if="o.user_id.phone">Telefone: <t t-esc="o.user_id.phone"/></t>
                        <t t-else="">Telefone: (19) 3877-5025</t><br/><br/>
                        <span style="color:#1f4e79;">
                            <t t-if="o.user_id.email"><t t-esc="o.user_id.email"/></t>
                            <t t-else="">Vendedor sem email em seu cadastro</t>
                        </span><br/><br/>
                        ARTUR NOGUEIRA, <span t-field="o.date_order" t-options='{"widget":"date"}'/>
                    </div>
                </div>

            </div>

            <div class="footer" style="text-align: right; font-size: 11px; padding: 4px 15px;">
                Página: <span class="page"/> / <span class="topage"/>
            </div>
        </t>
    </template>
</odoo>