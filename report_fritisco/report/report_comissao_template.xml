<odoo>
<template id="report_comissao_template">
    <t t-call="web.external_layout">
        <main>
            <div class="page">

                <style>
                    table {
                        page-break-inside: auto;
                    }

                    tr {
                        page-break-inside: avoid;
                        page-break-after: auto;
                    }

                    thead {
                        display: table-header-group;
                    }

                    tfoot {
                        display: table-footer-group;
                    }

                    td, th {
                        page-break-inside: avoid;
                    }
                </style>

                <div style="margin-bottom:20px;">
                    <h2 style="text-align:center;">
                        Relatório de Comissão
                    </h2>

                    <table class="table table-sm" style="margin-top:15px;">
                        <tr>
                            <td>
                                <strong>Vendedor</strong><br/>
                                <span t-esc="', '.join(vendedor.mapped('name'))"/>
                            </td>

                            <td>
                                <strong>Data Inicial</strong><br/>
                                <span t-esc="data_inicial"/>
                            </td>

                            <td>
                                <strong>Data Final</strong><br/>
                                <span t-esc="data_final"/>
                            </td>
                        </tr>
                    </table>
                </div>

                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th>Cliente</th>
                            <th>Referência</th>
                            <th>Emissão</th>

                           <th class="text-center">Parcela</th>
                           <th class="text-center">Forma de pagamento</th>
                            <th>Data Pagamento</th>

                            <th class="text-end">Valor Recebido (R$)</th>
                            <th class="text-end">% Comissão</th>
                            <th class="text-end">Comissão (R$)</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr t-foreach="docs" t-as="l">

                            <td>
                                <span t-esc="l['cliente']"/>
                            </td>

                            <td>
                                <span t-esc="l['referencia']"/>
                            </td>

                            <td>
                                <span t-esc="l['emissao']"/>
                            </td>

                           <td class="text-center">
                                <span t-esc="l['parcela']"/>
                            </td>

                            <td class="text-center">
                                <span t-esc="l['forma_pagamento']"/>
                            </td>

                            <td>
                                <span t-esc="l['data_pagamento']"/>              
                            </td>

                            <td class="text-end">
                                <span t-esc="'{:,.2f}'.format(l['valor_pago'])"/>
                            </td>

                            <td class="text-end">
                                <span t-esc="l['percentual']"/>%
                            </td>

                            <td class="text-end">
                                <span t-esc="'{:,.2f}'.format(l['comissao'])"/>
                            </td>

                        </tr>
                    </tbody>

                    <tfoot>
                        <tr>
                            <td colspan="5" class="text-end">
                                <strong>Totais:</strong>
                            </td>

                            <td class="text-end">
                                <strong>
                                    <span t-esc="'{:,.2f}'.format(total_vendido)"/>
                                </strong>
                            </td>

                            <td></td>

                            <td class="text-end">
                                <strong>
                                    <span t-esc="'{:,.2f}'.format(total_comissao)"/>
                                </strong>
                            </td>
                        </tr>
                    </tfoot>

                </table>

            </div>
        </main>
    </t>
</template>
</odoo>