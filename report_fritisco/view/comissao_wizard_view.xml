<odoo>
    <record id="view_report_comissao_wizard_form" model="ir.ui.view">
        <field name="name">report.comissao.wizard.form</field>
        <field name="model">report.comissao.wizard</field>
        <field name="arch" type="xml">
            <form string="Relatório de Comissão">

                <group>
                    <group>
                        <field name="vendedor_id"/>
                    </group>

                    <group>
                        <field name="data_inicial" required="1"/>
                        <field name="data_final" required="1"/>
                        <field name="comissao" required="1"/>
                    </group>
                </group>

                <footer>
                    <button name="action_print_report"
                            string="Imprimir Relatório"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancelar"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>

            </form>
        </field>
    </record>

    <record id="action_report_comissao_wizard" model="ir.actions.act_window">
        <field name="name">Relatório de Comissão</field>
        <field name="res_model">report.comissao.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="report_comissao_wizard" model="ir.actions.report">
    <field name="name">Relatório de Comissão</field>
    <field name="model">report.comissao.wizard</field>

    <field name="report_type">qweb-pdf</field>

    <field name="report_name">report_fritisco.report_comissao_template</field>

    <field name="report_file">report_fritisco.report_comissao_template</field>

    <field name="print_report_name">'Relatorio_Comissao'</field>

    <field name="binding_model_id" ref="model_report_comissao_wizard"/>
    <field name="binding_type">report</field>
</record>

<menuitem
    id="menu_relatorios_fritisco"
    name="Relatórios Fritisco"
    parent="account.menu_finance_reports"
    sequence="90"/>
    <menuitem
    id="menu_report_comissao"
    name="Relatório de Comissão"
    parent="menu_relatorios_fritisco"
    action="action_report_comissao_wizard"
    sequence="10"/>

</odoo>